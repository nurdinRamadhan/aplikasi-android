# ==============================================================================
# SUPABASE EDGE FUNCTIONS SECRETS EXAMPLE
# ==============================================================================
# Salin file ini menjadi file .env (JANGAN di-commit ke repositori)
# Gunakan perintah: supabase secrets set --env-file .env
# ==============================================================================

# Database & Supabase Core
SUPABASE_URL=your_project_url
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Payment Gateway (Midtrans)
MIDTRANS_SERVER_KEY=your_midtrans_server_key
MIDTRANS_IS_PRODUCTION=false

# AI & LLM (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key
AI_EMBEDDING_MODEL=gemini-embedding-001

# Notifications & Webhooks
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ADMIN_CHAT_ID=your_chat_id
TELEGRAM_WEBHOOK_SECRET=your_random_secret
FCM_SERVICE_ACCOUNT_BASE64=your_fcm_service_account_json_in_base64

# Maps & Geocoding
GOOGLE_MAPS_API_KEY=your_google_maps_key

# Configuration
TELEGRAM_GEMINI_TIMEOUT_MS=25000
TELEGRAM_ALLOW_INSECURE_DEV=false
RAG_MAX_CHUNKS=4
RAG_MATCH_THRESHOLD_PUBLIC=0.70
RAG_MATCH_THRESHOLD_KITAB=0.65
RAG_MATCH_THRESHOLD_INTERNAL=0.72
